{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  // A Worker with no script that serves the Zensical build from site/.
  "name": "wiki",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    // Unknown paths get site/404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  // Wrangler creates the DNS record and certificate for these on deploy.
  "routes": [{ "pattern": "wiki.alimahani.com", "custom_domain": true }],
}
